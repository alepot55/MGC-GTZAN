%--------------------------------------
%  Font Settings (modern hierarchy)
%--------------------------------------

% Detect legacy flag if defined in main theme
\newif\ifce@legacyfonts
\ifdefined\ce@legacy\ce@legacyfontstrue\fi

% Use modern web-style fonts if compiling with XeLaTeX / LuaLaTeX
\newif\ifce@xetexorluatex
\ifdefined\luatexversion\ce@xetexorluatextrue\fi
\ifdefined\XeTeXversion\ce@xetexorluatextrue\fi

\ifce@xetexorluatex
	\RequirePackage{fontspec}
	\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
	\ifdefined\CleanEasy@academic
		% Prefer Libertinus (serif accademico), fallback a TeX Gyre Termes, poi Latin Modern
		\IfFontExistsTF{Libertinus Serif}{\setmainfont{Libertinus Serif}\setsansfont{Libertinus Sans}\setmonofont{Libertinus Mono}}{%
			\IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}\setsansfont{TeX Gyre Heros}}{%
				\IfFontExistsTF{Latin Modern Roman}{\setmainfont{Latin Modern Roman}}{\setmainfont{Times New Roman}}%
			}%
		}%
	\else
		% Modern sans (Inter / Roboto / Latin Modern Sans)
		\IfFontExistsTF{Inter}{\setmainfont{Inter}\setsansfont{Inter}}{%
			\IfFontExistsTF{Roboto}{\setmainfont{Roboto}\setsansfont{Roboto}}{%
				\IfFontExistsTF{Latin Modern Sans}{\setmainfont{Latin Modern Sans}}{\RequirePackage[T1]{fontenc}\RequirePackage{lmodern}}%
			}%
		}%
	\fi
\else
	% pdfLaTeX fallback
	\RequirePackage[T1]{fontenc}
	\RequirePackage{lmodern}
	\ifdefined\CleanEasy@academic
		\renewcommand{\familydefault}{\rmdefault}
	\else
		\renewcommand{\familydefault}{\sfdefault}
	\fi
\fi

% Structure & base
\ifdefined\CleanEasy@academic
	\setbeamerfont{structure}{family=\rmfamily,series=\mdseries}
\else
	\setbeamerfont{structure}{family=\sffamily,series=\mdseries}
\fi

% Title hierarchy (slightly tighter steps for modern look)
\setbeamerfont{title}{size=\Large,series=\bfseries,parent=structure}
\setbeamerfont{subtitle}{size=\normalsize,parent=title}
\setbeamerfont{frametitle}{size=\large,series=\bfseries,parent=structure}
\setbeamerfont{framesubtitle}{parent=frametitle,size=\normalsize,series=\mdseries}

% Meta information
\setbeamerfont{author}{size=\normalsize,series=\mdseries,parent=structure}
\setbeamerfont{institute}{size=\footnotesize,series=\mdseries,parent=structure}
\setbeamerfont{date}{size=\footnotesize,series=\mdseries,parent=structure}

% TOC
\setbeamerfont{section in toc}{size=\normalsize,series=\bfseries,parent=structure}
\setbeamerfont{subsection in toc}{size=\small,series=\mdseries,parent={section in toc}}
\setbeamerfont{section in head/foot}{size=\tiny,parent=structure}

% Blocks
\setbeamerfont{block title}{size=\normalsize,series=\bfseries,parent=structure}
\setbeamerfont{block body}{size=\small,parent=structure}

% Caption & items
\setbeamerfont{caption}{size=\footnotesize}
\setbeamerfont{item}{parent=structure,series=\mdseries}

% Math fonts: keep professional fonts for consistency (match sans body)
\usefonttheme{professionalfonts}
% Optionally load mathsans if user desires; we keep defaults for readability.