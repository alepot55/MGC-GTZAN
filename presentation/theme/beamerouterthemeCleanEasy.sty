%--------------------------------------
%  Outer Theme Settings
%--------------------------------------

% Frame numbering
\setbeamertemplate{page number in head/foot}[totalframenumber]

% Navigation symbols (disabled)
\setbeamertemplate{navigation symbols}{}


% Standard footline (legacy kept for reference under name CleanEasy legacy)
\defbeamertemplate*{footline}{CleanEasy legacy}{%
  \leavevmode
  \hbox{%
    \begin{beamercolorbox}[wd=.2\paperwidth,ht=2.25ex,dp=1ex,left]{author in head/foot}%
      \usebeamerfont{author in head/foot}\hspace*{3ex}\textcolor{fg!50}{\insertshortauthor}\end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.65\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
      \usebeamerfont{title in head/foot}\textcolor{fg!50}{\insertshorttitle}\end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.15\paperwidth,ht=2.25ex,dp=1ex,right]{date in head/foot}%
      \usebeamerfont{date in head/foot}\textcolor{fg!50}{\insertframenumber{}/\inserttotalframenumber}\hspace*{1.2ex}\end{beamercolorbox}%
  }\vskip0pt
}

% Modern minimal footline with progress bar
\defbeamertemplate*{footline}{CleanEasy modern}{%
  \leavevmode
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.2ex,dp=0.6ex,left]{title in head/foot}
    \usebeamerfont{title in head/foot}\hspace*{0.8ex}\insertshorttitle\hfill\insertframenumber/\inserttotalframenumber\hspace*{0.8ex}
  \end{beamercolorbox}%
  % Progress bar
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.9pt,dp=0pt,left]{progress bar}
    % Background track
    \color{progress bar.bg}\rule{\paperwidth}{0.9pt}%
    % Foreground progress (simple proportional width)
    \color{progress bar.fg}\rule{\dimexpr \paperwidth * \insertframenumber / \inserttotalframenumber \relax}{0.9pt}%
  \end{beamercolorbox}
}

% Empty footline for title and plain pages
\defbeamertemplate{footline}{empty}{}


% Header with logo support (optional)
\defbeamertemplate*{headline}{CleanEasy theme}{%
  % Empty by default
  % Uncomment and modify the following to add a header
  %\begin{beamercolorbox}[wd=\paperwidth,ht=0.12\paperheight,dp=1ex]{title in head/foot}
  %  \vbox to 0.12\paperheight{\vfil\inserttitlenavigationhorizontal{\paperwidth}{}{}\vfil}
  %\end{beamercolorbox}
}

% Section page
\defbeamertemplate*{section page}{CleanEasy theme}{%
  \begin{frame}[plain]
    \vfill
    \begin{center}
      {\usebeamerfont{title}\color{structure.fg}\insertsection\par}
      \vspace{0.6em}
      {\color{CEAccent}\rule{0.55\linewidth}{2pt}}\par
    \end{center}
    \vfill
  \end{frame}
}

% Sidebar navigation (disabled by default)
\setbeamertemplate{sidebar left}{}
\setbeamertemplate{sidebar right}{}

% Background (can be customized)
\setbeamertemplate{background canvas}[default]

