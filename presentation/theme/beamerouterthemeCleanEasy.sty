% Special handling for title page
\AtBeginDocument{%
  % Select footline variant depending on legacy flag (set in main theme)
  \ifdefined\CleanEasy@academic
    % Footline accademico: solo numero pagina / totale
    \defbeamertemplate*{footline}{CleanEasy academic}{%
      \leavevmode
      \hfill\usebeamerfont{date in head/foot}\insertframenumber/\inserttotalframenumber\hspace*{1.2ex}\vskip2pt}
    \setbeamertemplate{footline}[CleanEasy academic]
  \else
    \ifdefined\ce@legacy
      \setbeamertemplate{footline}[CleanEasy legacy]
    \else
      \setbeamertemplate{footline}[CleanEasy modern]
    \fi
  \fi
  
  % Use empty footline for title page and TOC
  \BeforeBeginEnvironment{frame}{%
    \ifdefined\CleanEasy@academic
      \setbeamertemplate{footline}[CleanEasy academic]%
    \else
      \ifdefined\ce@legacy
        \setbeamertemplate{footline}[CleanEasy legacy]%
      \else
        \setbeamertemplate{footline}[CleanEasy modern]%
      \fi
    \fi
  }
  
  \apptocmd{\maketitle}{%
    \setbeamertemplate{footline}[empty]% (title page)
  }{}{}
  
  \apptocmd{\tableofcontents}{%
    \setbeamertemplate{footline}[empty]% (TOC)
  }{}{}
}

\AtBeginSection[]{
  \ifdefined\CleanEasy@academic
    \begin{frame}[plain]
      \vfill
      \centering
      {\usebeamerfont{frametitle}\insertsectionhead\par}
      \vspace{0.4em}
      {\color{black!25}\rule{0.35\linewidth}{0.6pt}}\par
      \vfill
    \end{frame}
  \else
    \begin{frame}[plain]
      \vfill
      \centering
      {\usebeamerfont{title}\color{structure.fg}\insertsectionhead\par}
      \vspace{0.6em}
      {\color{CEAccent}\rule{0.45\linewidth}{1.6pt}}\par
      \vfill
    \end{frame}
  \fi
}